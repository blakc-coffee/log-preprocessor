{
  "name": "ulpf-control-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-dist.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint": "eslint . && node scripts/check-design.mjs && npm run --silent format:check",
    "fonts": "node scripts/copy-fonts.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"scripts/*.mjs\" playwright.config.ts vite.config.ts eslint.config.js",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\" \"scripts/*.mjs\" playwright.config.ts vite.config.ts eslint.config.js"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-virtual": "3.14.13",
    "lucide-react": "1.48.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "msw": "2.15.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
